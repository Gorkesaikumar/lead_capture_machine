# V4 Studio - Backend Environment Variables
# Copy this file to .env and fill in the actual values

# Django Settings
SECRET_KEY=django-insecure-change-this-to-a-long-random-string-in-production
DEBUG=False
ALLOWED_HOSTS=studio.example.com,api.example.com
FRONTEND_URL=https://studio.example.com
CORS_ALLOWED_ORIGINS=https://studio.example.com
CSRF_TRUSTED_ORIGINS=https://studio.example.com
DJANGO_LOG_LEVEL=INFO

# Database Settings
POSTGRES_DB=v4_studio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis & Celery Settings
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Security (Production)
SECURE_SSL_REDIRECT=True

# Meta/Instagram Integration
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_VERIFY_TOKEN=your_secure_webhook_verify_token
INSTAGRAM_ACCESS_TOKEN=your_instagram_page_access_token

# WhatsApp Integration
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_system_user_access_token
WHATSAPP_BOOKING_TEMPLATE_NAME=studio_booking_invitation
WHATSAPP_DEFAULT_LANGUAGE=en
