# V4 Studio - Backend Environment Variables
# Copy this file to .env and fill in the actual values

# Django Settings
SECRET_KEY=django-insecure-change-this-to-a-long-random-string-in-production
DEBUG=False
ALLOWED_HOSTS=studio.example.com,api.example.com
FRONTEND_URL=https://studio.example.com
CORS_ALLOWED_ORIGINS=https://studio.example.com
CSRF_TRUSTED_ORIGINS=https://studio.example.com
DJANGO_LOG_LEVEL=INFO

# Database Settings
POSTGRES_DB=v4_studio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis & Celery Settings
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Security (Production)
SECURE_SSL_REDIRECT=True

# Meta/Instagram Integration
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_VERIFY_TOKEN=your_secure_webhook_verify_token
INSTAGRAM_ACCESS_TOKEN=your_instagram_page_access_token

# WhatsApp Integration
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_system_user_access_token
WHATSAPP_BOOKING_TEMPLATE_NAME=studio_booking_invitation
WHATSAPP_DEFAULT_LANGUAGE=en

# Messaging platform configuration. Select a supported Graph API version in the Meta dashboard.
META_APP_ID=replace_with_meta_app_id
META_GRAPH_API_VERSION=v25.0
META_WHATSAPP_REDIRECT_URI=https://api.example.com/api/v1/integrations/oauth/whatsapp/callback/
# Runtime sends use encrypted IntegrationConfig per workspace, not global access tokens.
# For configure_meta_channel only: inject META_CHANNEL_ACCESS_TOKEN from your secret manager.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=studio@example.com

# Razorpay Standard Checkout: configure captured payments and signed webhooks.
# Monthly automatic renewal uses Razorpay Subscriptions and signed webhooks.
RAZORPAY_API_KEY=
RAZORPAY_SECRET_KEY=
RAZORPAY_WEBHOOK_SECRET=
# Monthly mandate charges before reauthorization is required (not unlimited).
RAZORPAY_SUBSCRIPTION_CYCLES=120

# Meta SaaS onboarding: public API origin and Instagram product credentials.
META_REDIRECT_BASE_URL=
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_REDIRECT_URI=
# Facebook Login for Business configuration with WhatsApp Embedded Signup variation.
META_WHATSAPP_CONFIG_ID=
