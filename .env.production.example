# V4 Studio - Production Environment Variables Example
# Copy this file to .env.production and fill in the actual values before running docker-compose

# -----------------------------------------------------------------------------
# Django Configuration
# -----------------------------------------------------------------------------
# MUST be set to False in production
DEBUG=False

# Generate a secure random string for production (e.g. openssl rand -base64 32)
SECRET_KEY=replace_with_a_highly_secure_random_string

# Comma-separated list of allowed hostnames (e.g. yourdomain.com,api.yourdomain.com)
ALLOWED_HOSTS=yourdomain.com,localhost,127.0.0.1

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
POSTGRES_DB=v4_studio
POSTGRES_USER=v4_studio_user
# Use a strong, secure password
POSTGRES_PASSWORD=replace_with_secure_db_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# These URLs correspond to the internal redis service defined in docker-compose
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# -----------------------------------------------------------------------------
# Meta (Instagram/WhatsApp) API Integration
# -----------------------------------------------------------------------------
# Your Meta App Secret (found in App Dashboard > App Settings > Basic)
META_APP_SECRET=replace_with_meta_app_secret

# The custom verify token you set when configuring the Webhook in Meta App Dashboard
META_WEBHOOK_VERIFY_TOKEN=replace_with_your_custom_webhook_verify_token

# Access tokens for the specific page/business
INSTAGRAM_ACCESS_TOKEN=replace_with_instagram_access_token
WHATSAPP_ACCESS_TOKEN=replace_with_whatsapp_access_token

# Phone Number ID for WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=replace_with_whatsapp_phone_number_id
