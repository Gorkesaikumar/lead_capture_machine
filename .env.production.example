# V4 Studio - Production Environment Variables Example
# Copy this file to .env.production and fill in the actual values before running docker-compose

# -----------------------------------------------------------------------------
# Django Configuration
# -----------------------------------------------------------------------------
# MUST be set to False in production
DEBUG=False

# Generate a secure random string for production (e.g. openssl rand -base64 32)
SECRET_KEY=replace_with_a_highly_secure_random_string

# Comma-separated list of allowed hostnames (e.g. yourdomain.com,api.yourdomain.com)
ALLOWED_HOSTS=yourdomain.com,localhost,127.0.0.1

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
POSTGRES_DB=v4_studio
POSTGRES_USER=v4_studio_user
# Use a strong, secure password
POSTGRES_PASSWORD=replace_with_secure_db_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# These URLs correspond to the internal redis service defined in docker-compose
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# -----------------------------------------------------------------------------
# Meta (Instagram/WhatsApp) API Integration
# -----------------------------------------------------------------------------
# Your Meta App Secret (found in App Dashboard > App Settings > Basic)
META_APP_SECRET=replace_with_meta_app_secret

# The custom verify token you set when configuring the Webhook in Meta App Dashboard
META_VERIFY_TOKEN=replace_with_your_custom_webhook_verify_token

# Access tokens for the specific page/business
INSTAGRAM_ACCESS_TOKEN=replace_with_instagram_access_token
WHATSAPP_ACCESS_TOKEN=replace_with_whatsapp_access_token

# Phone Number ID for WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=replace_with_whatsapp_phone_number_id

# Messaging platform configuration. Select a supported Graph API version in the Meta dashboard.
META_APP_ID=replace_with_meta_app_id
META_GRAPH_API_VERSION=v25.0
META_WHATSAPP_REDIRECT_URI=https://api.example.com/api/v1/integrations/oauth/whatsapp/callback/
# Runtime sends use encrypted IntegrationConfig per workspace, not global access tokens.
# For configure_meta_channel only: inject META_CHANNEL_ACCESS_TOKEN from your secret manager.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=studio@example.com

DJANGO_SETTINGS_MODULE=config.settings.production
FRONTEND_URL=https://studio.example.com
CORS_ALLOWED_ORIGINS=https://studio.example.com
CSRF_TRUSTED_ORIGINS=https://studio.example.com,https://api.example.com

# Razorpay Standard Checkout: configure captured payments and signed webhooks.
# Monthly automatic renewal uses Razorpay Subscriptions and signed webhooks.
RAZORPAY_API_KEY=
RAZORPAY_SECRET_KEY=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_SUBSCRIPTION_CYCLES=120

# Meta SaaS onboarding: public API origin and Instagram product credentials.
META_REDIRECT_BASE_URL=
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_REDIRECT_URI=
# Facebook Login for Business configuration with WhatsApp Embedded Signup variation.
META_WHATSAPP_CONFIG_ID=
